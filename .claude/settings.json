{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validation/*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai/*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/selftest.ps1)",
      "Bash(pwsh -NoProfile -File scripts/validation/*)",
      "Bash(pwsh -NoProfile -File scripts/ai/*)",
      "Bash(bash scripts/validation/*)",
      "Bash(bash scripts/ai/*)",
      "Bash(bash scripts/hooks/selftest.sh)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/.npmrc)",
      "Read(./**/.pypirc)",
      "Read(./**/credentials)",
      "Read(./secrets/**)",

      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.development)",
      "Write(./.env.staging)",
      "Write(./.env.production)",
      "Write(./.env.test)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Write(./**/*.pfx)",
      "Write(./**/*.p12)",
      "Write(./**/*.jks)",
      "Write(./**/*.keystore)",
      "Write(./**/id_rsa)",
      "Write(./**/id_ed25519)",
      "Write(./**/.npmrc)",
      "Write(./**/.pypirc)",
      "Write(./secrets/**)",

      "Write(./.git/**)",
      "Write(./.ai/tasks/completed/**)",
      "Write(./.ai/plans/completed/**)",
      "Write(./.ai/plans/abandoned/**)",
      "Edit(./.git/**)",
      "Edit(./.ai/tasks/completed/**)",
      "Edit(./.ai/plans/completed/**)",
      "Edit(./.ai/plans/abandoned/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash.ps1\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-discovery.ps1\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-governance.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/scan-secrets.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
