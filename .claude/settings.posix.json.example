{
  "_comment": "POSIX variant: Linux and WSL are proven in CI. Copy over .claude/settings.json when adopting the blueprint on a POSIX host. Identical policy; only the hook interpreter changes. On macOS the hooks need bash 4+ and GNU coreutils ahead of the stock bash 3.2 and BSD tools -- see the root README.",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(bash scripts/validation/*)",
      "Bash(bash scripts/ai/*)",
      "Bash(bash scripts/hooks/selftest.sh)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/.npmrc)",
      "Read(./**/.pypirc)",
      "Read(./**/credentials)",
      "Read(./secrets/**)",

      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.development)",
      "Write(./.env.staging)",
      "Write(./.env.production)",
      "Write(./.env.test)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Write(./**/*.pfx)",
      "Write(./**/*.p12)",
      "Write(./**/*.jks)",
      "Write(./**/*.keystore)",
      "Write(./**/id_rsa)",
      "Write(./**/id_ed25519)",
      "Write(./**/.npmrc)",
      "Write(./**/.pypirc)",
      "Write(./secrets/**)",

      "Write(./.git/**)",
      "Write(./.ai/tasks/completed/**)",
      "Write(./.ai/plans/completed/**)",
      "Write(./.ai/plans/abandoned/**)",
      "Edit(./.git/**)",
      "Edit(./.ai/tasks/completed/**)",
      "Edit(./.ai/plans/completed/**)",
      "Edit(./.ai/plans/abandoned/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-discovery.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-governance.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/scan-secrets.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
